# Optional panel listener settings.
# PANEL_PORT=3000
# PANEL_HOST=0.0.0.0        # use 127.0.0.1 when Nginx or Ngrok is in front (see website/deploy)
# PANEL_TLS_CERT=/path/to/fullchain.pem   # serve HTTPS directly, no proxy needed
# PANEL_TLS_KEY=/path/to/privkey.pem

# Optional Discord sign-in. Register this exact callback in Discord's Developer Portal.
# PANEL_DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
# PANEL_DISCORD_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET
# PANEL_DISCORD_REDIRECT_URI=https://panel.example.com/api/auth/discord/callback
# Only this Discord ID can create the first owner account through Discord.
# PANEL_DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID
# Other Discord accounts permitted to register/sign in (comma-separated); new accounts get dashboard access only.
# PANEL_DISCORD_ALLOWED_IDS=
