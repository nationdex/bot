# Optional. The bot gives the panel its own API token automatically (it needs /access claim once).
# Set these only to point the panel at another API or to use a token you made yourself.
# API_BASE_URL=http://127.0.0.1:2222/v1
# API_BEARER_TOKEN=ndx_...
# PANEL_PORT=3000
# PANEL_HOST=0.0.0.0        # use 127.0.0.1 when Nginx or Ngrok is in front (see website/deploy)
# PANEL_TLS_CERT=/path/to/fullchain.pem   # serve HTTPS directly, no proxy needed
# PANEL_TLS_KEY=/path/to/privkey.pem
