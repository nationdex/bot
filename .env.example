TOKEN=YOUR_DISCORD_APP_TOKEN
HOME_GUILD_ID=YOUR_MAIN_SERVER_ID

# Remote extras management (disabled until a dedicated token is configured).
# Generate a long random token; never use your Discord token here.
# EXTRAS_API_TOKEN=
# EXTRAS_ALLOWED_ORIGINS=https://index.nationdex.com
# EXTRAS_CATALOG_FILE=extras-catalog.json
# Explicitly allow the connection token to install trusted code on this host.
# EXTRAS_ALLOW_INSTALL=true
# EXTRAS_DIRECTORY=data/extras
