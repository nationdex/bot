{
  "name": "nationdex",
  "version": "1.0.0",
  "description": "The Project Nationdex 2026, also known as Nationdex 2.0, is a modern revival from one of the oldest Ballsdex-like dex bots in existence, which is named Nationdex.bot!",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "fix": "rm -rf dist/ && npm run build",
    "typecheck": "tsc --noEmit",
    "validate:collectibles": "npm run build && node dist/util/validateCollectibles.js",
    "website:install": "npm install --prefix website",
    "website:build": "npm run build --prefix website",
    "prod:build": "npm run build && npm run website:install && npm run website:build",
    "pm2:start": "npm run prod:build && npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:delete": "npx pm2 delete ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs",
    "pm2:status": "npx pm2 status"
  },
  "author": "NationDex Team (https://github.com/nationdex)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nationdex/bot.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/nationdex/bot/issues"
  },
  "homepage": "https://github.com/nationdex/bot#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@nationdex/api": "github:nationdex/api#main",
    "@nationdex/db": "github:nationdex/db#dev",
    "@tryforge/forge.canvas": "github:tryforge/ForgeCanvas#dev",
    "@tryforge/forgescript": "github:tryforge/ForgeScript#main",
    "dotenv": "^17.4.2",
    "pm2": "^7.0.4",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.55.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "pm2": "^7.0.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "6.28.0",
    "ip-address": "10.5.0",
    "brace-expansion": "2.1.4",
    "js-yaml": "5.2.3"
  }
}
