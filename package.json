{
  "name": "pnd26",
  "version": "1.0.0",
  "description": "The Project Nationdex 2026 is a modern reimagining of the oldest Ballsdex alternative in existence, known as Nationdex.bot!",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun scripts/start-all-dev.ts",
    "dev:all": "bun scripts/start-all-dev.ts",
    "start:all": "bun scripts/start-all.ts",
    "prod": "bun scripts/start-all.ts",
    "check": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tryforge/forge.canvas": "^1.3.0",
    "@tryforge/forge.db": "^2.1.1",
    "@tryforge/forgescript": "^2.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "postgres": "^3.4.9"
  },
  "patchedDependencies": {
    "pg@8.20.0": "patches/pg@8.20.0.patch",
    "@tryforge/forgescript@2.6.0": "patches/@tryforge%2Fforgescript@2.6.0.patch"
  }
}
