{
  "name": "nationdex",
  "version": "1.2.0",
  "description": "The Project Nationdex 2026, also known as Nationdex 2.0, is a modern revival from one of the oldest dex bots in existence, which is named Nationdex.bot!",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun run bundle:prep",
    "panel:build": "bun website/build.ts",
    "panel:bench": "bun website/bench.ts",
    "panel:ngrok": "ngrok http ${PANEL_PORT:-3000}",
    "bundle:prep": "bun src/scripts/bundle-prep.ts",
    "build:binary": "bun src/scripts/build-binary.ts linux-x64",
    "build:binary:arm64": "bun src/scripts/build-binary.ts linux-arm64",
    "build:binary:windows-x64": "bun src/scripts/build-binary.ts windows-x64",
    "build:binary:darwin-arm64": "bun src/scripts/build-binary.ts darwin-arm64",
    "build:binary:darwin-x64": "bun src/scripts/build-binary.ts darwin-x64",
    "build:binary:android-arm64": "bun src/scripts/build-binary.ts android-arm64",
    "start": "bun src/index.ts",
    "start:binary": "test -f ./binaries/nationdex-bot-linux-x64 || tar -xzf ./binaries/nationdex-bot-linux-x64.tar.gz -C ./binaries; ./binaries/nationdex-bot-linux-x64",
    "start:binary:arm64": "test -f ./binaries/nationdex-bot-linux-arm64 || tar -xzf ./binaries/nationdex-bot-linux-arm64.tar.gz -C ./binaries; ./binaries/nationdex-bot-linux-arm64",
    "start:binary:darwin-arm64": "test -f ./binaries/nationdex-bot-darwin-arm64 || tar -xzf ./binaries/nationdex-bot-darwin-arm64.tar.gz -C ./binaries; ./binaries/nationdex-bot-darwin-arm64",
    "start:binary:darwin-x64": "test -f ./binaries/nationdex-bot-darwin-x64 || tar -xzf ./binaries/nationdex-bot-darwin-x64.tar.gz -C ./binaries; ./binaries/nationdex-bot-darwin-x64",
    "dev": "bun --watch src/index.ts",
    "lint": "bun node_modules/forge.lint/dist/cli.js",
    "typecheck": "bun check && bun check -p website",
    "validate:collectibles": "bun src/core/data/collectibles.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:forge": "bun node_modules/forge.lint/dist/cli.js --fix",
    "format:forge:check": "bun node_modules/forge.lint/dist/cli.js --check"
  },
  "author": "Nationdex Solutions (https://github.com/nationdex)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nationdex/bot.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/nationdex/bot/issues"
  },
  "homepage": "https://github.com/nationdex/bot#readme",
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@nationdex/api": "github:nationdex/api#main",
    "@nationdex/db": "github:nationdex/db#main",
    "@tryforge/forge.canvas": "github:tryforge/ForgeCanvas#dev",
    "@tryforge/forgescript": "github:tryforge/ForgeScript#main",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "forge.lint": "^1.1.0"
  },
  "trustedDependencies": [
    "@nationdex/api"
  ]
}
