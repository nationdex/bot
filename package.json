{
  "name": "nationdex",
  "version": "1.0.0",
  "description": "The Project NationDex 2.0 is a modern revival of the oldest BallsDex alternative in existence, known as NationDex!",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "check": "biome check",
    "check:fix": "biome check --write",
    "fix": "rm -rf dist/ && npm run build",
    "typecheck": "tsc --noEmit",
    "website:install": "npm install --prefix website",
    "website:build": "npm run build --prefix website",
    "prod:build": "npm run build && npm run website:install && npm run website:build",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "author": "NationDex Team (https://github.com/nationdex)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nationdex/bot.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/nationdex/bot/issues"
  },
  "homepage": "https://github.com/nationdex/bot#readme",
  "dependencies": {
    "@tryforge/forge.canvas": "^1.3.0",
    "@tryforge/forge.db": "github:tryforge/forgedb#main",
    "@tryforge/forgescript": "github:tryforge/forgescript#dev",
    "better-sqlite3": "^12.10.0",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
