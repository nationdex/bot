{
  "name": "pnd26",
  "version": "1.0.0",
  "description": "The Project Nationdex 2026 is a modern reimagining of the oldest Ballsdex alternative in existence, known as Nationdex.bot!",
  "module": "index.ts",
  "scripts": {
    "start": "bun run --watch index.ts",
    "check": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "pm": "bm2 start ecosystem.config.ts",
    "pm:fg": "bm2 start ecosystem.config.ts --no-daemon",
    "pm:dev": "NODE_ENV=development bm2 start ecosystem.config.ts",
    "pm:stop": "bm2 stop all",
    "pm:restart": "bm2 restart all",
    "pm:list": "bm2 list",
    "pm:logs": "bm2 logs",
    "pm:save": "bm2 save && bm2 startup install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tryforge/forge.canvas": "^1.3.0",
    "@tryforge/forge.db": "^2.1.1",
    "@tryforge/forgescript": "^2.6.0",
    "@types/pg": "^8.20.0",
    "bm2": "^1.0.37",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "postgres": "^3.4.8",
    "tsx": "^4.21.0"
  },
  "patchedDependencies": {
    "pg@8.20.0": "patches/pg@8.20.0.patch",
    "@tryforge/forgescript@2.6.0": "patches/@tryforge%2Fforgescript@2.6.0.patch"
  }
}
