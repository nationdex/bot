{
  "name": "nationdex",
  "version": "1.0.0",
  "description": "The Project NationDex 2.0 is a modern revival of the oldest BallsDex alternative in existence, known as NationDex!",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "check": "biome check",
    "check:fix": "biome check --write",
    "fix": "rm -rf dist/ && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "author": "NationDex Team (https://github.com/nationdex)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nationdex/bot.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/nationdex/bot/issues"
  },
  "homepage": "https://github.com/nationdex/bot#readme",
  "dependencies": {
    "@tryforge/forge.canvas": "^1.3.0",
    "@tryforge/forge.db": "github:tryforge/forgedb#main",
    "@tryforge/forgescript": "github:tryforge/forgescript#dev",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.10.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
